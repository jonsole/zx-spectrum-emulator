{
  "name": "stepscroll-designer",
  "displayName": "Stepscroll Designer",
  "description": "Editors for examples/stepscroll: its tiles (tiles.json) and its blocks (blocks.json), and (to come) its map. Independent of the emulator extension.",
  "version": "0.0.1",
  "publisher": "jonsole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonsole/zx-spectrum-emulator",
    "directory": "examples/stepscroll/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCustomEditor:stepscroll.tiles",
    "onCommand:stepscroll.openTiles",
    "onCustomEditor:stepscroll.blocks",
    "onCommand:stepscroll.openBlocks"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "stepscroll.tiles",
        "displayName": "Stepscroll Tiles",
        "selector": [
          {
            "filenamePattern": "**/examples/stepscroll/world/tiles.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "stepscroll.blocks",
        "displayName": "Stepscroll Blocks",
        "selector": [
          {
            "filenamePattern": "**/examples/stepscroll/world/blocks.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "stepscroll.openTiles",
        "title": "Open Tiles",
        "category": "Stepscroll"
      },
      {
        "command": "stepscroll.openBlocks",
        "title": "Open Blocks",
        "category": "Stepscroll"
      }
    ]
  }
}
