{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jetrun map",
  "description": "The world: which tile (by its name in tiles.json) each page holds, row by row from the top. The columns wrap round from east to west; above the top row is sky and below the bottom row rock. See examples/jetrun/GLOSSARY.md.",
  "type": "object",
  "required": [
    "rows",
    "colours",
    "start"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 128,
        "items": {
          "type": "string"
        }
      }
    },
    "start": {
      "description": "Where the astronaut first stands: a page [column, row] and the place of their feet in it.",
      "type": "object",
      "required": [
        "page",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 223
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 159
        }
      }
    },
    "colours": {
      "description": "The rock's colours, as Cyberun colours it: one ink above cavernRow, another from it down, on black paper. Cyberun's renderer colours the cells along each surface; the play area takes the view's colour at a life's start.",
      "type": "object",
      "required": [
        "surface",
        "caverns",
        "cavernRow"
      ],
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "object",
          "required": [
            "ink"
          ],
          "additionalProperties": false,
          "properties": {
            "ink": {
              "enum": [
                "blue",
                "red",
                "magenta",
                "green",
                "cyan",
                "yellow",
                "white"
              ]
            },
            "bright": {
              "type": "boolean"
            }
          }
        },
        "caverns": {
          "type": "object",
          "required": [
            "ink"
          ],
          "additionalProperties": false,
          "properties": {
            "ink": {
              "enum": [
                "blue",
                "red",
                "magenta",
                "green",
                "cyan",
                "yellow",
                "white"
              ]
            },
            "bright": {
              "type": "boolean"
            }
          }
        },
        "cavernRow": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
