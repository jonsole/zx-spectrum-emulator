{
  // What is left here is what opening a file cannot do for you.
  //
  // A .sna, .z80, .tap or .tzx in the Explorer opens on a page with Run and
  // Debug buttons (vscode-extension/program_view.js), and a .sld and source
  // file of the same name beside it are loaded with it -- so every "run this
  // committed snapshot" configuration this file used to carry is now a
  // double-click. What is kept is the ROM, which is no file to open; the three
  // games assembled from source on every launch; the exercisers, which need
  // uncapped speed; the two tape loads that are not the default fast one; and
  // attach.
  //
  // None of these start the emulator themselves: with no `debugServer`, the
  // extension connects to zxspectrum.server.dapPort and starts zx_server there
  // if nothing is listening (server_view.js), with the ports, ROMs and sound
  // its settings ask for. The one exception is the last configuration, which
  // rebuilds the emulator first -- for when the emulator is what you are
  // changing. The `preLaunchTask` the three games name only assembles their
  // source; the server is still the extension's business.
  //
  // The `type` matches the vscode-extension/ debugger registration.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ZX Spectrum: Step through ROM",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom"
    },
    {
      // The 128K: the 32K ROM pair (roms/128.rom, ROM 0 then ROM 1) and the
      // machine to go with it. Boots to the 128 menu; "Tape Loader" is the
      // first entry, so a tape given here auto-starts through it.
      "name": "ZX Spectrum 128: Step through ROM",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/128.rom",
      "machine": "128"
    },
    {
      // Your own Filmation engine (examples/filmation) -- the masked-sprite
      // blitter, stepped in its own source. Assembled on every launch by the
      // preLaunchTask, so editing any of the .s files and relaunching runs
      // what you just wrote.
      //
      // `asm` names the ENTRY source only. knightlore.s INCLUDEs the other
      // knightlore/ sources and ../engine/'s, and the SLD names the first by
      // their path from knightlore.s's folder -- which is where they are
      // resolved -- and the second in full, so stepping lands in whichever
      // file the code is actually in.
      "name": "ZX Spectrum: Filmation",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/examples/filmation/knightlore/output/knightlore.z80",
      "sld": "${workspaceFolder}/examples/filmation/knightlore/output/knightlore.sld",
      "asm": "${workspaceFolder}/examples/filmation/knightlore/knightlore.s",
      "preLaunchTask": "filmation.build"
    },
    {
      // Knight Lore 128K: the fork of the Filmation entry above that grows
      // into a bigger castle on the 128K (examples/filmation/knightlore128).
      "name": "ZX Spectrum: Knight Lore 128K",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/examples/filmation/knightlore128/output/knightlore128.z80",
      "sld": "${workspaceFolder}/examples/filmation/knightlore128/output/knightlore128.sld",
      "asm": "${workspaceFolder}/examples/filmation/knightlore128/knightlore128.s",
      "preLaunchTask": "knightlore128.build"
    },
    {
      // Fairlight, reassembled on every launch from the disassembly in the
      // game-disassemblies submodule -- run its build script once after a
      // fresh clone, since it fetches what it needs from the network.
      "name": "ZX Spectrum: Fairlight",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/game-disassemblies/game_disassembly/fairlight/fairlight.sna",
      "sld": "${workspaceFolder}/game-disassemblies/game_disassembly/fairlight/fairlight.sld",
      "asm": "${workspaceFolder}/game-disassemblies/game_disassembly/fairlight/fairlight.asm",
      "preLaunchTask": "fairlight.build"
    },
    {
      // Knight Lore, disassembled again on every launch by the preLaunchTask
      // -- so editing game-disassemblies/scripts/knightlore_annotations.ctl
      // and relaunching steps through the commentary you just wrote.
      //
      // The disassembly starts at $6108 and runs to the top of memory. Below
      // that is the game's own RAM, which is deliberately not disassembled:
      // $5C08 upwards is forty object records of thirty-two bytes, laid
      // straight over the ROM's system variables. Watch $5C08 to follow
      // object zero.
      //
      // The snapshot is taken mid-game, so this comes up already playing
      // rather than at a menu. Break on $AFBD to stop once per frame at the
      // top of the object loop, or on $B5F7 to catch every keyboard read.
      "name": "ZX Spectrum: Knight Lore",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/game-disassemblies/game_disassembly/knightlore/knightlore.sna",
      "sld": "${workspaceFolder}/game-disassemblies/game_disassembly/knightlore/knightlore.sld",
      "asm": "${workspaceFolder}/game-disassemblies/game_disassembly/knightlore/knightlore.asm",
      "preLaunchTask": "knightlore.build"
    },
    {
      // The same tape opening a .tzx would load, but the way a real cassette
      // does it: fast load off, so the ROM reads actual pulses off the EAR
      // line. Press Continue and watch it take about ten seconds, with loading
      // stripes in the border and the loading screech out of the speakers.
      // This is the path every turbo and custom loader falls back to, and the
      // reason this one is a launch configuration: opening a tape file always
      // fast-loads it.
      "name": "ZX Spectrum: Tape (real pulse load)",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "tape": "${workspaceFolder}/tapes/loading-test.tzx",
      "tapeFastLoad": false
    },
    {
      // The generic one: boots, types LOAD "" and stops in the ROM loader with
      // no tape at all -- exactly where a real Spectrum sits once you have typed
      // the command and not yet pressed Play.
      //
      // Press Continue, then feed the loader that is already running:
      //     load_tape   { "path": "...", "auto_start": false }
      //     tape_control{ "action": "play" }
      //
      // That path always loads at real tape speed, even with fast load on, and
      // it is not a bug: the trap fires on ARRIVING at LD-BYTES, and by now the
      // ROM is already sitting inside it. Which is the point of this target --
      // it is for watching a real load, and for breakpointing the loader with a
      // tape you choose at the time. For an instant load, open the tape file
      // itself (or "ZX Spectrum: Load Tape...") and it resets and retypes, so
      // the trap gets its moment.
      "name": "ZX Spectrum: Tape (waiting for LOAD)",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "waitForTape": true,
      "tapeFastLoad": false
    },
    {
      // The exercisers below all run `uncapped` -- which is why they are here
      // rather than opened from snapshots/: at 50 frames a second they would
      // take hours. They have no visual output to get wrong and take minutes
      // even so. Nothing comes out of the speakers while they run, whatever
      // the sound setting says -- the beeper is switched off entirely at
      // uncapped speed.
      "name": "ZX Spectrum: Z80 full test suite",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/z80full.sna",
      "uncapped": true
    },
    {
      "name": "ZX Spectrum: ZEXALL",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/zexall.sna",
      "uncapped": true
    },
    {
      "name": "ZX Spectrum: ZEXDOC",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/zexdoc.sna",
      "uncapped": true
    },
    {
      // The narrow one: CCF/SCF set the undocumented flag bits from A and the
      // PREVIOUS flags, which the two suites above largely mask out.
      "name": "ZX Spectrum: ZEXCCFB (CCF/SCF flag test)",
      "type": "zxspectrum",
      "request": "launch",
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/zexccfb.sna",
      "uncapped": true
    },
    {
      // Joins a machine that is ALREADY RUNNING instead of starting one: the
      // server an MCP client auto-started (see tools/zxserver), or one left
      // behind by an earlier session. Nothing is reset, no ROM or snapshot is
      // loaded, and whatever the machine is doing keeps doing it -- so this
      // is the configuration for "something is running, let me look at it".
      //
      // Add "sld" and "asm" to step a program's source rather than raw
      // disassembly; they are the only settings attach accepts, because
      // everything else in a launch config resets the machine.
      "name": "ZX Spectrum: Attach to running emulator",
      "type": "zxspectrum",
      "request": "attach"
    },
    {
      // The only configuration that still starts the server itself, because
      // it is the only one that needs it built first: the preLaunchTask stops
      // whatever is running (Windows will not relink an executable in use),
      // rebuilds zx_server and starts it, and `debugServer` has VS Code talk
      // to that port directly. Use this one when the emulator is what you are
      // changing; anything above is quicker.
      "name": "ZX Spectrum: Step through ROM (rebuild the emulator)",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    }
  ]
}
