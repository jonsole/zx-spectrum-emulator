{
  // Every configuration here connects to the same thing: zx_server.exe's DAP
  // port. `debugServer` tells VS Code to talk to an already-running adapter
  // rather than launching one, and the `preLaunchTask` -- the same one for
  // every configuration here -- is what starts it:
  //
  //   zxspectrum-cpp.start-server   build, then serve, with sound out of the
  //                                 host's speakers rather than the screen panel
  //
  // The `type` is still required to match the vscode-extension/ debugger
  // registration before VS Code will attempt the connection at all.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ZX Spectrum: Step through ROM",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      "name": "ZX Spectrum: hello_rom_call example",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/examples/hello_rom_call/test.sna",
      "sld": "${workspaceFolder}/examples/hello_rom_call/test.sld",
      "asm": "${workspaceFolder}/examples/hello_rom_call/test.asm",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // Committed example, no build step: writes the border register in a
      // tight loop, so a correct ULA draws stripes and a wrong one doesn't.
      // Snapshot only -- there is no .sld beside it to step the source with.
      "name": "ZX Spectrum: Border rainbow example",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/examples/border_rainbow/test.sna",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // Committed example: IM2 + EI/HALT, then one LDIR copying 256 bytes
      // from uncontended memory into the screen. Written to isolate write-side
      // memory contention -- which this core does not emulate yet, so what it
      // shows today is the uncontended timing, not the real thing.
      "name": "ZX Spectrum: LDIR contention example",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/examples/ldir_contention/test.sna",
      "sld": "${workspaceFolder}/examples/ldir_contention/test.sld",
      "asm": "${workspaceFolder}/examples/ldir_contention/test.asm",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      "name": "ZX Spectrum: Manic Miner",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/game_disassembly/manicminer/mm.sna",
      "sld": "${workspaceFolder}/game_disassembly/manicminer/mm.sld",
      "asm": "${workspaceFolder}/game_disassembly/manicminer/mm.asm",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // The speed-patched build from scripts/build_manicminer_fast.py: same
      // game, ~1.65x through its main loop. Run that script first -- it needs
      // mm.asm, so scripts/build_manicminer.py has to have run at least once.
      "name": "ZX Spectrum: Manic Miner (fast)",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/game_disassembly/manicminer/mm-fast.sna",
      "sld": "${workspaceFolder}/game_disassembly/manicminer/mm-fast.sld",
      "asm": "${workspaceFolder}/game_disassembly/manicminer/mm-fast.asm",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // As above, but locked to the frame interrupt via IM 2 + HALT: a steady
      // cadence instead of a loop time that varies with what is on screen.
      "name": "ZX Spectrum: Manic Miner (frame-locked)",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/game_disassembly/manicminer/mm-sync.sna",
      "sld": "${workspaceFolder}/game_disassembly/manicminer/mm-sync.sld",
      "asm": "${workspaceFolder}/game_disassembly/manicminer/mm-sync.asm",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      "name": "ZX Spectrum: Fairlight",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/game_disassembly/fairlight/fairlight.sna",
      "sld": "${workspaceFolder}/game_disassembly/fairlight/fairlight.sld",
      "asm": "${workspaceFolder}/game_disassembly/fairlight/fairlight.asm",
      "preLaunchTask": "fairlight.build-and-start-server"
    },
    {
      "name": "ZX Spectrum: Aquaplane",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/game_disassembly/aquaplane/aquaplane.sna",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // Multichannel beeper music -- it drives port 0xFE far harder than a
      // typical game, so it is the useful stress test for the audio path.
      "name": "ZX Spectrum: Chronos",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/Chronos.sna",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // Tape loading, the fast way: the ROM's LD-BYTES is trapped and each
      // standard-speed block is satisfied instantly. The tape is a generated
      // autostarting BASIC program (scripts/make_test_tape.py), so a
      // successful load turns the border yellow and prints TAPE LOADED OK --
      // by the time this config finishes launching, it has already happened.
      "name": "ZX Spectrum: Tape (fast load)",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "tape": "${workspaceFolder}/tapes/loading-test.tap",
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // The same tape, loaded the way a real cassette would be: fast load off,
      // so the ROM reads actual pulses off the EAR line. Press Continue and
      // watch it take about ten seconds, with loading stripes in the border
      // and the loading screech out of the speakers. This is the path
      // every turbo and custom loader falls back to.
      "name": "ZX Spectrum: Tape (real pulse load)",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "tape": "${workspaceFolder}/tapes/loading-test.tzx",
      "tapeFastLoad": false,
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // The generic one: boots, types LOAD "" and stops in the ROM loader with
      // no tape at all -- exactly where a real Spectrum sits once you have typed
      // the command and not yet pressed Play.
      //
      // Press Continue, then feed the loader that is already running:
      //     load_tape   { "path": "...", "auto_start": false }
      //     tape_control{ "action": "play" }
      //
      // That path always loads at real tape speed, even with fast load on, and
      // it is not a bug: the trap fires on ARRIVING at LD-BYTES, and by now the
      // ROM is already sitting inside it. Which is the point of this target --
      // it is for watching a real load, and for breakpointing the loader with a
      // tape you choose at the time. For an instant load, insert with
      // auto_start left on (what "ZX Spectrum: Load Tape..." does) and it resets
      // and retypes, so the trap gets its moment.
      "name": "ZX Spectrum: Tape (waiting for LOAD)",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "waitForTape": true,
      "tapeFastLoad": false,
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // The exercisers below all run `uncapped`: they have no visual output to
      // get wrong and take minutes even so. Nothing comes out of the speakers
      // while they do -- the beeper is switched off entirely at uncapped
      // speed -- even though they start the same audio-enabled server.
      "name": "ZX Spectrum: Z80 full test suite",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/z80full.sna",
      "uncapped": true,
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      "name": "ZX Spectrum: ZEXALL",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/zexall.sna",
      "uncapped": true,
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      "name": "ZX Spectrum: ZEXDOC",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/zexdoc.sna",
      "uncapped": true,
      "preLaunchTask": "zxspectrum-cpp.start-server"
    },
    {
      // The narrow one: CCF/SCF set the undocumented flag bits from A and the
      // PREVIOUS flags, which the two suites above largely mask out.
      "name": "ZX Spectrum: ZEXCCFB (CCF/SCF flag test)",
      "type": "zxspectrum",
      "request": "launch",
      "debugServer": 4711,
      "rom": "${workspaceFolder}/roms/48.rom",
      "snapshot": "${workspaceFolder}/snapshots/zexccfb.sna",
      "uncapped": true,
      "preLaunchTask": "zxspectrum-cpp.start-server"
    }
  ]
}
