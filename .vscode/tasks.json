{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zxspectrum.start-server",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "-d", "Ubuntu-24.04",
        "--",
        "bash", "-lc",
        "source .venv/bin/activate && python -m zxspectrum.server.main --dap-port 4711 --mcp-port 8000"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Uvicorn running on"
        }
      }
    }
  ]
}
