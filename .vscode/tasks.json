{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zxspectrum.start-server",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv-win\\Scripts\\python.exe",
      "args": ["-m", "zxspectrum.server.main", "--dap-port", "4711", "--mcp-port", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Uvicorn running on"
        }
      }
    }
  ]
}
