{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zxspectrum.start-server",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv-win\\Scripts\\python.exe",
      "args": [
        "-m", "zxspectrum.server.main",
        "--dap-port", "4711",
        "--mcp-port", "8000",
        "--screen-port", "8500"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Uvicorn running on"
        }
      }
    },
    {
      "label": "zxspectrum-cpp.build",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "build.ps1", "-Release"],
      "options": { "cwd": "${workspaceFolder}/cpp-core" },
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "zxspectrum-cpp.start-server",
      "type": "shell",
      "command": "${workspaceFolder}\\cpp-core\\build\\RelWithDebInfo\\zx_server.exe",
      "args": [
        "--dap-port", "4711",
        "--mcp-port", "8000",
        "--screen-port", "8500",
        // Without this the server outlives the debug session, and the NEXT
        // launch's build step fails to link zx_server.exe because the old one
        // still has it open (LNK1168). To keep a server alive for MCP use
        // outside VS Code, run the exe by hand without this flag.
        "--exit-on-disconnect"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "zxspectrum-cpp.build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum-cpp",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ZX Spectrum server",
          "endsPattern": "DAP server listening"
        }
      }
    },
    {
      "label": "zxspectrum-rust.start-server",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": [
        "run",
        "-p", "zx-server",
        "--",
        "--dap-port", "4711",
        "--mcp-port", "8000",
        "--screen-port", "8500"
      ],
      "options": { "cwd": "${workspaceFolder}/rust-core" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum-rust",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ZX Spectrum Rust server",
          "endsPattern": "DAP server listening"
        }
      }
    },
    {
      "label": "zxspectrum-rust.start-server-release",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": [
        "run",
        "--release",
        "-p", "zx-server",
        "--",
        "--dap-port", "4711",
        "--mcp-port", "8000",
        "--screen-port", "8500"
      ],
      "options": { "cwd": "${workspaceFolder}/rust-core" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum-rust",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ZX Spectrum Rust server",
          "endsPattern": "DAP server listening"
        }
      }
    }
  ]
}
