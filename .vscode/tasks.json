{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zxspectrum.start-server",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv-win\\Scripts\\python.exe",
      "args": [
        "-m", "zxspectrum.server.main",
        "--dap-port", "4711",
        "--mcp-port", "8000",
        "--screen-port", "8500"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Uvicorn running on"
        }
      }
    },
    {
      "label": "zxspectrum-rust.start-server",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": [
        "run",
        "-p", "zx-server",
        "--",
        "--dap-port", "4711",
        "--mcp-port", "8000",
        "--screen-port", "8500"
      ],
      "options": { "cwd": "${workspaceFolder}/rust-core" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum-rust",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ZX Spectrum Rust server",
          "endsPattern": "DAP server listening"
        }
      }
    },
    {
      "label": "zxspectrum-rust.start-server-release",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": [
        "run",
        "--release",
        "-p", "zx-server",
        "--",
        "--dap-port", "4711",
        "--mcp-port", "8000",
        "--screen-port", "8500"
      ],
      "options": { "cwd": "${workspaceFolder}/rust-core" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "zxspectrum-rust",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ZX Spectrum Rust server",
          "endsPattern": "DAP server listening"
        }
      }
    }
  ]
}
