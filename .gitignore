__pycache__/
*.pyc
.venv/
.venv-win/
*.egg-info/
build/
dist/
zxspectrum/_native/*.so
zxspectrum/_native/*.pyd
zxspectrum/_native/*.o
zxspectrum/_native/_z80.c
roms/*
!roms/.gitkeep
.pytest_cache/

# Fetched reference copy of z80_gen.py (github.com/floooh/chips) -- a
# reading aid for scripts/generate_z80_dispatch.py, which ports its
# algorithm to C++; not committed since it's someone else's source tree,
# not this project's, and generate_z80_dispatch.py is the actual artifact.
.chips-codegen-src/

# Fetched ZEXALL/ZEXDOC (GPL v2.0, github.com/agn453/ZEXALL) -- a standalone
# Z80 exerciser used only as a test fixture, not linked into the emulator;
# fetched rather than committed to avoid vendoring a second project's tree.
.zexall-src/

# Fetched/generated ROM disassembly (copyrighted -- Amstrad / Logan &
# O'Hara / Dymond -- same treatment as roms/: never committed, see README)
.rom-disassembly-src/
rom_disassembly/

# Left over from before the game disassemblies moved to their own repository
# (github.com/jonsole/zx-spectrum-disassemblies, checked out here as the
# game-disassemblies submodule). Kept ignored so an existing clone's output
# does not suddenly show up as untracked; safe to delete.
.manicminer-disassembly-src/
.fairlight-disassembly-src/
game_disassembly/

# Game snapshots and tape images (copyrighted -- same treatment as roms/ and
# the disassemblies above). The .sna files that ARE committed here are the Z80
# exercisers, which are freely distributable, and tapes/ holds only what
# scripts/make_test_tape.py generates -- so both are listed back in by name
# rather than the whole directory being left unguarded.
snapshots/*.sna
!snapshots/z80full.sna
!snapshots/zexall.sna
!snapshots/zexccfb.sna
!snapshots/zexdoc.sna
# .z80 has no exceptions: save_snapshot writes .sna or .z80 by the path's
# extension, and every .z80 that lands here is a game paused mid-run.
snapshots/*.z80
tapes/*.tap
tapes/*.tzx
tapes/*.wav
tapes/*.csw
!tapes/loading-test.tap
!tapes/loading-test.tzx

# Fetched sjasmplus binary (github.com/z00m128/sjasmplus) -- a build tool,
# not this project's own code; fetched by the LDIR contention example's
# build task rather than committed. Scoped to its own directory rather than
# all of tools/, which also holds committed things (trace_viewer.html).
tools/sjasmplus/

# Scratch git worktrees created for isolated agent runs -- each is a full
# checkout of the repo, not project content. The tracked parts of .claude/
# (agents/, skills/) are committed normally.
.claude/worktrees/
trace_screen.rgb

# Captured bus traces (zx_server --trace-log / the start_trace MCP tool), and
# the copies the trace-log tests write beside themselves. Outputs, not source
# -- the one committed trace is tests/data/visualz80_reference.txt, which is
# the reference the tests diff against.
*.zxtrace
zx_test_*.txt
# ...and the SLD fixture symbol_tests writes beside them.
zx_test_*.sld

# Scope screenshots and waveform CSVs pulled off the Rigol MSO5074
# (tools/rigol/) -- bench captures, not project source.
captures/

# examples/filmation build output (sjasmplus: the snapshot, its SLD and the
# listing) -- regenerated by examples/filmation/knightlore/build.py on every
# launch -- and the unit tests' assembled programs, from
# examples/filmation/engine/tests/run_tests.py.
examples/filmation/knightlore/output/
examples/filmation/output/

# The flow this repository follows, for both games:
#
#   your game --(extract, ONCE)--> sprites.json + sprites.png
#                                  rooms.json, specials.json
#                                        |
#                                        v  (build.py, every time)
#                                  the .s files --> the game
#
# The files in the middle are CARRIED and are what you edit, by hand or in the
# designers. Nothing regenerates them -- that is the whole point, and it is why
# build.py stops rather than re-running an extractor. What the extractors write
# in the games' own packed shapes is scratch: it is listed below, it is yours
# alone, and once the JSON exists nothing needs it again.
#
# sprite_data.s and the rest are the assembly forms the build makes from the
# carried files, so they are not carried either.
examples/filmation/knightlore/sprite_data.bin
examples/filmation/knightlore/graphic_map.json
# ...and the .bin an older kl_extract.py wrote before the map became JSON.
examples/filmation/knightlore/graphic_map.bin
examples/filmation/knightlore/sprite_data.s

# ...and the graphic-number table that sprite_source.py writes beside it. It is
# a second file only because the two go to different places in the image: the
# table wants a 512-byte boundary, and behind the bitmaps its padding was the
# last thing in the image and rounded the whole thing up.
examples/filmation/knightlore/sprite_table.s
examples/filmation/knightlore/sprite_adj_gen.s
examples/filmation/knightlore/graphics_gen.s

# The font, the same way round as the sprites above: the packed file, the sheet
# font_sheet.py unpacks it into, and the assembly form font_source.py builds
# from that sheet. Forty characters is not much of a game, but it is still
# Ultimate's artwork and this repository is public, so none of it is carried.
# Run kl_extract.py once against your own copy to produce the packed file, and
# build.py makes the sheet from it the first time it needs one.
examples/filmation/knightlore/font.bin
examples/filmation/knightlore/font.png
examples/filmation/knightlore/font.json
examples/filmation/knightlore/font.s

# The rest of Knight Lore's extraction, and the assembly the build makes from
# the carried JSON. rooms.json and specials.json are carried; room_data.bin and
# specials.bin are what they were first decoded out of, and nothing reads them
# again.
#
# Note that the pixel nudges in sprites.json cannot be re-made from any of
# this: adj.py harvests them from a RUNNING game. That is the one thing here
# with no second copy anywhere, which is why sprites.json is carried and why
# every tool that writes it merges rather than replacing.
examples/filmation/knightlore/room_data.bin
examples/filmation/knightlore/room_data.s
examples/filmation/knightlore/specials.bin
examples/filmation/knightlore/specials_gen.s

# Pentagram, on the same line as Knight Lore above: sprites.json, sprites.png
# and rooms.json are carried and are what you edit; what pg_extract.py writes
# in the game's own packed shapes is scratch.
examples/filmation/pentagram/sprite_data.bin
examples/filmation/pentagram/graphic_map.json
examples/filmation/pentagram/sprite_data.s
examples/filmation/pentagram/sprite_table.s
examples/filmation/pentagram/sprite_adj_gen.s
examples/filmation/pentagram/font.bin
examples/filmation/pentagram/font.png
examples/filmation/pentagram/font.json
examples/filmation/pentagram/font.s
examples/filmation/pentagram/room_data.bin
examples/filmation/pentagram/room_data.s
examples/filmation/pentagram/graphic_map.bin
examples/filmation/pentagram/quest.bin
examples/filmation/pentagram/quest_data.s
examples/filmation/pentagram/sound.bin
examples/filmation/pentagram/sound_data.s
examples/filmation/pentagram/sound_title.s
examples/filmation/pentagram/output/

# Knight Lore 128K, a fork of knightlore/ that extracts nothing of its own: its
# JSON and sheet are carried like the others', its font is read from
# knightlore/'s unpacked sheet, and everything listed here is what build.py
# assembles from them.
examples/filmation/knightlore128/sprite_data.s
examples/filmation/knightlore128/sprite_library.s
examples/filmation/knightlore128/room_sprites.s
examples/filmation/knightlore128/sprite_table.s
examples/filmation/knightlore128/sprite_adj_gen.s
examples/filmation/knightlore128/graphics_gen.s
examples/filmation/knightlore128/font.s
examples/filmation/knightlore128/room_data.s
examples/filmation/knightlore128/room_list.s
examples/filmation/knightlore128/specials_gen.s
examples/filmation/knightlore128/output/

# isoblocks: everything build.py generates -- the view tables, the block
# drawers, the map's bytes, the assembled demo -- is rebuilt from art/, maps/
# and isogeom.py.
examples/isoblocks/output/

# Vendored reference copy of github.com/simon-frankau/head-over-heels -- a
# reverse-engineered disassembly of Head Over Heels, kept to hand while its
# Filmation engine design is ported into examples/filmation. Never committed:
# it carries the game's own bytes (memimage/memimage.z80, tape/*.tzx,
# bin/*.bin sprites), it is someone else's project tree rather than ours, and
# it states no licence at all. Same treatment as .chips-codegen-src/ and the
# game snapshots above. Clone it yourself:
#   git clone https://github.com/simon-frankau/head-over-heels vendor/head-over-heels
vendor/head-over-heels/

# What scripts/package_release.py stages into a copy of the extension for a
# release -- never into the extension itself, but kept out in case.
vscode-extension/bin/
vscode-extension/roms/
