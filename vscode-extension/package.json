{
  "name": "zxspectrum-debug",
  "displayName": "ZX Spectrum Debug",
  "description": "Debug ZX Spectrum programs in VS Code on a bundled, cycle-accurate emulator: breakpoints, stepping backwards, watchpoints, source-level Z80 assembly, a live screen, a profiler, and tape and graphics tools.",
  "version": "0.1.0",
  "publisher": "jonsole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonsole/zx-spectrum-emulator"
  },
  "homepage": "https://github.com/jonsole/zx-spectrum-emulator#readme",
  "bugs": {
    "url": "https://github.com/jonsole/zx-spectrum-emulator/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:zxspectrum.showScreen",
    "onCommand:zxspectrum.showServerScreen",
    "onCommand:zxspectrum.showTrace",
    "onCommand:zxspectrum.showGraphics",
    "onCommand:zxspectrum.showSelectionAsGraphics",
    "onCommand:zxspectrum.loadTape",
    "onView:zxspectrumTape",
    "onDebug:zxspectrum",
    "onDebugResolve:zxspectrum",
    "onCommand:zxspectrum.serverStart",
    "onCommand:zxspectrum.serverStop",
    "onCommand:zxspectrum.serverRestart",
    "onCommand:zxspectrum.serverLog",
    "onCommand:zxspectrum.sjasmplusPath",
    "onCommand:zxspectrum.runProgram",
    "onCommand:zxspectrum.debugProgram",
    "onCustomEditor:zxspectrum.program",
    "onCustomEditor:zxspectrum.tapeDesign",
    "onCustomEditor:zxspectrum.screenDesign",
    "onCommand:zxspectrum.designTape"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "zxspectrum.program",
        "displayName": "ZX Spectrum Program",
        "selector": [
          { "filenamePattern": "*.sna" },
          { "filenamePattern": "*.z80" },
          { "filenamePattern": "*.tap" },
          { "filenamePattern": "*.tzx" }
        ],
        "priority": "default"
      },
      {
        "viewType": "zxspectrum.tapeDesign",
        "displayName": "ZX Spectrum Tape",
        "selector": [
          { "filenamePattern": "*.tape.json" }
        ],
        "priority": "default"
      },
      {
        "viewType": "zxspectrum.screenDesign",
        "displayName": "ZX Spectrum Loading Screen",
        "selector": [
          { "filenamePattern": "*.screen.json" }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      { "fileMatch": "*.tape.json", "url": "./schemas/tape.schema.json" },
      { "fileMatch": "*.screen.json", "url": "./schemas/screen.schema.json" }
    ],
    "taskDefinitions": [
      {
        "type": "zxspectrum-tape",
        "required": ["tape"],
        "properties": {
          "tape": { "type": "string", "description": "The *.tape.json to build" }
        }
      }
    ],
    "languages": [
      {
        "id": "z80-asm",
        "aliases": ["Z80 Assembly", "z80-asm"],
        "extensions": [".asm", ".s", ".a80", ".z80"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "ZX Spectrum",
      "properties": {
        "zxspectrum.tapeDesigner.builder": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `build_tape.py` the tape designer builds with. Empty: the one in this extension's own repository (`scripts/build_tape.py`), or in a workspace folder's `scripts/`."
        },
        "zxspectrum.tapeDesigner.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Python the tape designer runs `build_tape.py` with. The zx-tape-loader scheme needs `numpy`. Empty: the repository's own virtual environment (`.venv-win`, `.venv` or `venv`), else `python` on the PATH."
        },
        "zxspectrum.tapeDesigner.sjasmplus": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `sjasmplus` the zx-tape-loader scheme assembles its loader with when a tape moves it from the top of RAM. Empty: `tools/sjasmplus` beside the builder, else `sjasmplus` on the PATH."
        },
        "zxspectrum.screen.filter": {
          "type": "string",
          "enum": ["nearest", "sharp-bilinear", "bilinear"],
          "enumDescriptions": [
            "Hard-edged pixels, as the ULA drew them. Uneven at in-between sizes.",
            "Hard-edged pixels, evenly sized at any size: nearest neighbour to a whole multiple, then bilinear for the rest.",
            "Smoothed, as a television would soften it."
          ],
          "default": "nearest",
          "description": "How the screen panel scales the Spectrum's picture."
        },
        "zxspectrum.screen.scale": {
          "type": "string",
          "enum": ["fit-integer", "fit", "1", "2", "3", "4"],
          "enumDescriptions": [
            "As large as the panel allows in whole steps, so every pixel is the same size.",
            "Fill the panel, keeping the shape.",
            "352 x 312",
            "704 x 624",
            "1056 x 936",
            "1408 x 1248"
          ],
          "default": "fit-integer",
          "description": "How large the screen panel draws the Spectrum's picture, border included."
        },
        "zxspectrum.screen.border": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 100,
          "markdownDescription": "How much of the border the screen panel shows, as a percentage of what the emulator draws (48 pixels each side, 64 lines above and 56 below): `100` is all of it, `0` the 256x192 paper alone. Each side keeps that share of its own depth, and the picture is scaled to fit what is left."
        },
        "zxspectrum.screen.scanlines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "markdownDescription": "How dark the gaps between the screen panel's scanlines are, as a percentage: `0` is off, `100` black. Drawn over the lower half of each Spectrum line, after the filter. Needs at least two device pixels to a line, so it shows nothing at `1x` on an unscaled display."
        },
        "zxspectrum.program.runOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Run a snapshot or tape as soon as it is opened, instead of showing it with Run and Debug buttons. Running one resets the emulator."
        },
        "zxspectrum.server.autoStart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Start the emulator when a debug session needs it and nothing is listening on `#zxspectrum.server.dapPort#`. Only for launch configurations without a `debugServer`: one with it connects to that port itself."
        },
        "zxspectrum.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where `zx_server` is. `${workspaceFolder}` and `~` are expanded. Left empty, the extension looks in each workspace folder's `cpp-core/build/RelWithDebInfo`, then on `PATH`."
        },
        "zxspectrum.server.roms": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "ROMs a started emulator loads (`--rom`). Left empty, `roms/48.rom` and `roms/128.rom` beside the emulator's checkout, when they are there. A launch configuration's own `rom` still applies to its session."
        },
        "zxspectrum.server.sound": {
          "type": "string",
          "enum": ["device", "panel", "off"],
          "enumDescriptions": [
            "Out of this computer's sound card, from the emulator itself.",
            "Through the screen panel.",
            "No sound."
          ],
          "default": "device",
          "description": "Where a started emulator's sound goes."
        },
        "zxspectrum.server.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Extra command-line arguments for a started emulator, after the ones the settings above make -- `--ffmpeg <path>`, say."
        },
        "zxspectrum.server.stopOnExit": {
          "type": "boolean",
          "default": true,
          "description": "Stop the emulator this window started when the window closes. It keeps running between debug sessions either way."
        },
        "zxspectrum.server.dapPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 4711,
          "markdownDescription": "The emulator's debug adapter port (`--dap-port`). Launch configurations without a `debugServer` connect here."
        },
        "zxspectrum.server.mcpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8000,
          "markdownDescription": "The port a started emulator serves MCP on (`--mcp-port`)."
        },
        "zxspectrum.server.screenPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8500,
          "markdownDescription": "The emulator's screen stream port (`--screen-port`), which the screen panel reads."
        },
        "zxspectrum.server.audioPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8501,
          "markdownDescription": "The emulator's audio stream port (`--audio-port`), which the screen panel plays when `#zxspectrum.server.sound#` is `panel`."
        }
      }
    },
    "breakpoints": [
      {
        "language": "z80-asm"
      }
    ],
    "grammars": [
      {
        "language": "z80-asm",
        "scopeName": "source.z80-asm",
        "path": "./syntaxes/z80-asm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zxspectrum.designTape",
        "title": "ZX Spectrum: Design Tape..."
      },
      {
        "command": "zxspectrum.serverStart",
        "title": "ZX Spectrum: Start Emulator"
      },
      {
        "command": "zxspectrum.serverStop",
        "title": "ZX Spectrum: Stop Emulator"
      },
      {
        "command": "zxspectrum.serverRestart",
        "title": "ZX Spectrum: Restart Emulator"
      },
      {
        "command": "zxspectrum.serverLog",
        "title": "ZX Spectrum: Show Emulator Log"
      },
      {
        "command": "zxspectrum.serverMenu",
        "title": "ZX Spectrum: Emulator"
      },
      {
        "command": "zxspectrum.runProgram",
        "title": "Run in ZX Spectrum",
        "icon": "$(play)"
      },
      {
        "command": "zxspectrum.debugProgram",
        "title": "Debug in ZX Spectrum",
        "icon": "$(debug-alt)"
      },
      {
        "command": "zxspectrum.screenScaling",
        "title": "ZX Spectrum: Screen Scaling...",
        "icon": "$(zoom-in)"
      },
      {
        "command": "zxspectrum.watchAddress",
        "title": "ZX Spectrum: Watch Address...",
        "icon": "$(eye)",
        "enablement": "debugType == 'zxspectrum'"
      },
      {
        "command": "zxspectrum.clearWatchpoint",
        "title": "Remove Watchpoint",
        "icon": "$(close)"
      },
      {
        "command": "zxspectrum.clearWatchpoints",
        "title": "ZX Spectrum: Remove All Watchpoints",
        "icon": "$(clear-all)"
      },
      {
        "command": "zxspectrum.toggleWatchpoint",
        "title": "Enable/Disable Watchpoint",
        "icon": "$(eye-closed)"
      },
      {
        "command": "zxspectrum.stepBackInto",
        "title": "ZX Spectrum: Step Back Into",
        "icon": {
          "light": "media/toolbar/step-back-into-light.svg",
          "dark": "media/toolbar/step-back-into-dark.svg"
        },
        "enablement": "debugState == 'stopped'"
      },
      {
        "command": "zxspectrum.stepBackOut",
        "title": "ZX Spectrum: Step Back Out",
        "icon": {
          "light": "media/toolbar/step-back-out-light.svg",
          "dark": "media/toolbar/step-back-out-dark.svg"
        },
        "enablement": "debugState == 'stopped'"
      },
      {
        "command": "zxspectrum.runBackToCursor",
        "title": "Run Back to Cursor",
        "enablement": "debugState == 'stopped'"
      },
      {
        "command": "zxspectrum.runBackToWrite",
        "title": "ZX Spectrum: Run Back to Last Write...",
        "enablement": "debugState == 'stopped'"
      },
      {
        "command": "zxspectrum.returnToLive",
        "title": "ZX Spectrum: Return to Live",
        "icon": {
          "light": "media/toolbar/return-to-live-light.svg",
          "dark": "media/toolbar/return-to-live-dark.svg"
        },
        "enablement": "debugState == 'stopped'"
      },
      {
        "command": "zxspectrum.showScreen",
        "title": "ZX Spectrum: Show Screen"
      },
      {
        "command": "zxspectrum.showServerScreen",
        "title": "ZX Spectrum: Show Screen of..."
      },
      {
        "command": "zxspectrum.showTrace",
        "title": "ZX Spectrum: Show Trace"
      },
      {
        "command": "zxspectrum.showGraphics",
        "title": "ZX Spectrum: Show Graphics",
        "icon": "$(symbol-color)"
      },
      {
        "command": "zxspectrum.showSelectionAsGraphics",
        "title": "Show Selection as ZX Spectrum Graphics",
        "icon": "$(symbol-color)"
      },
      {
        "command": "zxspectrum.loadTape",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Load Tape...",
        "icon": "$(folder-opened)"
      },
      {
        "command": "zxspectrum.saveSnapshot",
        "title": "ZX Spectrum: Save Snapshot..."
      },
      {
        "command": "zxspectrum.tapePlay",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Play Tape",
        "icon": "$(debug-continue)"
      },
      {
        "command": "zxspectrum.tapeStop",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Stop Tape",
        "icon": "$(debug-pause)"
      },
      {
        "command": "zxspectrum.tapeRewind",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Rewind Tape",
        "icon": "$(debug-restart)"
      },
      {
        "command": "zxspectrum.tapeEject",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Eject Tape",
        "icon": "$(close)"
      },
      {
        "command": "zxspectrum.tapeFastLoadOn",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Turn Tape Fast Load On",
        "icon": "$(rocket)"
      },
      {
        "command": "zxspectrum.tapeFastLoadOff",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Turn Tape Fast Load Off",
        "icon": "$(watch)"
      },
      {
        "command": "zxspectrum.writeOverlayOn",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Show Display Writes",
        "icon": "$(eye)"
      },
      {
        "command": "zxspectrum.writeOverlayOff",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Hide Display Writes",
        "icon": "$(eye-closed)"
      },
      {
        "command": "zxspectrum.writeOverlayFade",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Set Display Write Fade..."
      },
      {
        "command": "zxspectrum.writeOverlayOpacity",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Set Display Write Opacity..."
      },
      {
        "command": "zxspectrum.rasterMarkerOn",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Show Raster Position"
      },
      {
        "command": "zxspectrum.rasterMarkerOff",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Hide Raster Position"
      },
      {
        "command": "zxspectrum.rasterInProgressOn",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Show Frame In Progress"
      },
      {
        "command": "zxspectrum.rasterInProgressOff",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Show Last Completed Frame"
      },
      {
        "command": "zxspectrum.rasterPendingOn",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Show Pending Display Writes"
      },
      {
        "command": "zxspectrum.rasterPendingOff",
        "enablement": "zxspectrum.tapeSession",
        "title": "ZX Spectrum: Hide Pending Display Writes"
      },
      {
        "command": "zxspectrum.tapeSeek",
        "enablement": "zxspectrum.tapeSession",
        "title": "Seek Tape To This Block",
        "icon": "$(target)"
      },
      {
        "command": "zxspectrum.setSpeed",
        "title": "ZX Spectrum: Set Emulation Speed...",
        "icon": {
          "light": "media/toolbar/speed-light.svg",
          "dark": "media/toolbar/speed-dark.svg"
        }
      },
      {
        "command": "zxspectrum.profileStart",
        "title": "ZX Spectrum: Start Profiling",
        "icon": {
          "light": "media/toolbar/profile-start-light.svg",
          "dark": "media/toolbar/profile-start-dark.svg"
        }
      },
      {
        "command": "zxspectrum.profileStop",
        "title": "ZX Spectrum: Stop Profiling",
        "icon": {
          "light": "media/toolbar/profile-stop-light.svg",
          "dark": "media/toolbar/profile-stop-dark.svg"
        }
      },
      {
        "command": "zxspectrum.profileHotSpots",
        "title": "ZX Spectrum: Show Profile Hot Spots",
        "icon": "$(list-ordered)"
      },
      {
        "command": "zxspectrum.profileRefresh",
        "title": "ZX Spectrum: Refresh Profile"
      },
      {
        "command": "zxspectrum.profileClear",
        "title": "ZX Spectrum: Clear Profile",
        "icon": "$(clear-all)"
      },
      {
        "command": "zxspectrum.profileSortBySelf",
        "title": "ZX Spectrum: Sort Profile Tree by Own Code",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "zxspectrum.profileSortByTotal",
        "title": "ZX Spectrum: Sort Profile Tree by Total",
        "icon": "$(list-tree)"
      },
      {
        "command": "zxspectrum.profileMarkIdle",
        "title": "Mark as Idle",
        "icon": "$(watch)"
      },
      {
        "command": "zxspectrum.profileUnmarkIdle",
        "title": "Unmark Idle"
      },
      {
        "command": "zxspectrum.profileSetIdle",
        "title": "ZX Spectrum: Set Idle Routines..."
      },
      {
        "command": "zxspectrum.profileSetPeriod",
        "title": "ZX Spectrum: Set Profile Period..."
      },
      {
        "command": "zxspectrum.profileShowPeriod",
        "title": "Show on Source",
        "icon": "$(eye)"
      },
      {
        "command": "zxspectrum.profileShowAll",
        "title": "ZX Spectrum: Show Whole Profile on Source",
        "icon": "$(eye-closed)"
      },
      {
        "command": "zxspectrum.profileTintWithCalls",
        "title": "ZX Spectrum: Tint CALL Lines With Their Calls' Time"
      },
      {
        "command": "zxspectrum.profileTintOwnCode",
        "title": "ZX Spectrum: Tint Lines By Their Own Code Only"
      }
    ],
    "views": {
      "debug": [
        {
          "id": "zxspectrumTape",
          "name": "ZX Spectrum Tape",
          "when": "debugType == 'zxspectrum'"
        },
        {
          "id": "zxspectrumProfile",
          "name": "ZX Spectrum Profile",
          "when": "debugType == 'zxspectrum' || zxspectrum.hasProfile"
        },
        {
          "id": "zxspectrumWatchpoints",
          "name": "ZX Spectrum Watchpoints",
          "when": "debugType == 'zxspectrum'"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zxspectrumTape",
        "contents": "No tape in the deck.\n[Load tape...](command:zxspectrum.loadTape)"
      },
      {
        "view": "zxspectrumWatchpoints",
        "contents": "Nothing is being watched.\n\nA watchpoint stops the machine when the program reads or writes an address -- what wrote that? -- and says what changed and which instruction did it.\n[Watch an address...](command:zxspectrum.watchAddress)"
      },
      {
        "view": "zxspectrumProfile",
        "contents": "Nothing profiled yet. Start profiling, then let the program run: every routine it calls shows here, most expensive first, and expands into the routines it called. The worst frames come first once there are some.\n[Start profiling](command:zxspectrum.profileStart)\nIf the program waits in a loop of its own each frame, mark that routine idle so it does not count as work.\n[Set idle routines...](command:zxspectrum.profileSetIdle)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zxspectrum.watchAddress",
          "when": "debugType == 'zxspectrum' && resourceExtname =~ /^\\.(s|asm|a80|z80|inc|def|sym)$/",
          "group": "debug@5"
        },
        {
          "command": "zxspectrum.runBackToCursor",
          "when": "debugType == 'zxspectrum' && stepBackSupported && resourceExtname =~ /^\\.(s|asm|a80|z80|inc|def|sym)$/",
          "group": "debug@3"
        },
        {
          "command": "zxspectrum.runBackToWrite",
          "when": "debugType == 'zxspectrum' && stepBackSupported && resourceExtname =~ /^\\.(s|asm|a80|z80|inc|def|sym)$/",
          "group": "debug@4"
        },
        {
          "command": "zxspectrum.showSelectionAsGraphics",
          "when": "editorHasSelection && resourceExtname =~ /^\\.(s|asm|a80|z80|inc|def|sym)$/",
          "group": "zxspectrum@1"
        }
      ],
      "editor/title": [
        {
          "command": "zxspectrum.screenScaling",
          "when": "activeWebviewPanelId == 'zxspectrumScreen'",
          "group": "navigation@2"
        },
        {
          "command": "zxspectrum.writeOverlayOn",
          "when": "activeWebviewPanelId == 'zxspectrumScreen' && !zxspectrum.writeOverlay",
          "group": "navigation@1"
        },
        {
          "command": "zxspectrum.writeOverlayOff",
          "when": "activeWebviewPanelId == 'zxspectrumScreen' && zxspectrum.writeOverlay",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "zxspectrum.runProgram",
          "when": "resourceExtname =~ /^\\.(sna|z80|tap|tzx)$/i",
          "group": "navigation@90"
        },
        {
          "command": "zxspectrum.debugProgram",
          "when": "resourceExtname =~ /^\\.(sna|z80|tap|tzx)$/i",
          "group": "navigation@91"
        },
        {
          "command": "zxspectrum.designTape",
          "when": "resourceExtname =~ /^\\.(scr|sna|z80|tap|tzx)$/i",
          "group": "navigation@92"
        }
      ],
      "commandPalette": [
        {
          "command": "zxspectrum.runProgram",
          "when": "false"
        },
        {
          "command": "zxspectrum.debugProgram",
          "when": "false"
        },
        {
          "command": "zxspectrum.serverMenu",
          "when": "false"
        },
        {
          "command": "zxspectrum.serverStop",
          "when": "zxspectrum.serverRunning"
        },
        {
          "command": "zxspectrum.serverRestart",
          "when": "zxspectrum.serverRunning"
        },
        {
          "command": "zxspectrum.watchAddress",
          "when": "debugType == 'zxspectrum'"
        },
        {
          "command": "zxspectrum.clearWatchpoint",
          "when": "false"
        },
        {
          "command": "zxspectrum.toggleWatchpoint",
          "when": "false"
        },
        {
          "command": "zxspectrum.clearWatchpoints",
          "when": "debugType == 'zxspectrum' && zxspectrum.hasWatchpoints"
        },
        {
          "command": "zxspectrum.stepBackInto",
          "when": "debugType == 'zxspectrum' && stepBackSupported"
        },
        {
          "command": "zxspectrum.stepBackOut",
          "when": "debugType == 'zxspectrum' && stepBackSupported"
        },
        {
          "command": "zxspectrum.runBackToCursor",
          "when": "false"
        },
        {
          "command": "zxspectrum.runBackToWrite",
          "when": "debugType == 'zxspectrum' && stepBackSupported"
        },
        {
          "command": "zxspectrum.returnToLive",
          "when": "debugType == 'zxspectrum' && zxspectrum.inPast"
        },
        {
          "command": "zxspectrum.tapeSeek",
          "when": "false"
        },
        {
