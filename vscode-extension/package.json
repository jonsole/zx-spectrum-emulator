        },
        {
          "command": "zxspectrum.profileStop",
          "when": "debugType == 'zxspectrum' && zxspectrum.profiling"
        },
        {
          "command": "zxspectrum.profileRefresh",
          "when": "debugType == 'zxspectrum'"
        },
        {
          "command": "zxspectrum.profileMarkIdle",
          "when": "false"
        },
        {
          "command": "zxspectrum.profileUnmarkIdle",
          "when": "false"
        },
        {
