        {
          "command": "zxspectrum.stepBackOut",
          "when": "debugType == 'zxspectrum' && stepBackSupported",
          "group": "navigation@0"
        },
        {
          "command": "zxspectrum.returnToLive",
          "when": "debugType == 'zxspectrum' && zxspectrum.inPast",
          "group": "navigation@0"
        },
        {
          "command": "zxspectrum.setSpeed",
          "when": "debugType == 'zxspectrum'",
          "group": "navigation@1"
        },
        {
          "command": "zxspectrum.profileStart",
          "when": "debugType == 'zxspectrum' && !zxspectrum.profiling",
          "group": "navigation@2"
        },
        {
          "command": "zxspectrum.profileStop",
          "when": "debugType == 'zxspectrum' && zxspectrum.profiling",
          "group": "navigation@2"
        }
      ]
    },
    "debuggers": [
      {
        "type": "zxspectrum",
        "label": "ZX Spectrum",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "ports": {
                "description": "Which emulator this session is on. Left out, the one on zxspectrum.server.*Port, started if nothing is there. \"auto\" starts a new one on free ports for this session alone, stopped when it ends -- so a second session is a second machine. An object names ports ({ \"dap\": 14711, \"screen\": 18500 }): whatever is listening there is joined, or a server is started on them; a port left out is the setting's. Ignored with debugServer.",
                "oneOf": [
                  { "type": "string", "enum": ["auto"] },
                  {
                    "type": "object",
                    "properties": {
                      "dap": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "mcp": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "screen": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "audio": { "type": "integer", "minimum": 1, "maximum": 65535 }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "rom": {
                "type": "string",
                "description": "Path to a ROM image to load: 16K for the 48K, or 32K (ROM 0 then ROM 1, the usual 128.rom) for the 128K. Either can be loaded whatever machine is selected."
              },
              "machine": {
                "type": "string",
                "enum": ["48", "128"],
                "default": "48",
                "description": "Which Spectrum to be: \"48\" (the default) or \"128\", with paging, the shadow screen and the AY sound chip. A 128K needs a 32K rom. A snapshot switches the machine to whichever model it was taken on regardless."
              },
              "snapshot": {
                "type": "string",
                "description": "Path to a .sna or .z80 snapshot to load (48K or 128K; the machine becomes the model the snapshot needs). Falls back to reset() if omitted."
              },
              "sld": {
                "type": "string",
                "description": "Path to an sjasmplus SLD file, for source-level debugging of the loaded program. Requires asm."
              },
              "asm": {
                "type": "string",
                "description": "Path to the source the sld file was assembled from. Requires sld."
              },
              "tape": {
                "type": "string",
                "description": "Path to a tape image to insert at launch: .tap, .tzx, .wav or .csw, told apart by content rather than extension. A .wav or .csw is a recording, and always loads at tape speed."
              },
              "tapeAutoStart": {
                "type": "boolean",
                "default": true,
                "description": "Reset, type LOAD \"\" and start the tape automatically."
              },
              "waitForTape": {
                "type": "boolean",
                "default": false,
                "description": "Boot and type LOAD \"\" with no tape, leaving the machine in the ROM loader ready for one to be inserted later. Ignored when a tape is given and auto-started, which already types it."
              },
              "tapeFastLoad": {
                "type": "boolean",
                "default": true,
                "description": "Satisfy standard-speed tape blocks instantly by trapping the ROM's LD-BYTES routine. Turbo and custom loaders always fall back to real pulse playback."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop at the first instruction once the program is loaded. false carries straight on running it."
              },
              "uncapped": {
                "type": "boolean",
                "default": false,
                "description": "Run as fast as the host allows instead of at a real Spectrum's speed. For the Z80 exercisers, which have nothing to watch; the beeper is silent while uncapped. Leaves the speed as the server had it when omitted."
              }
            }
          },
          "attach": {
            "properties": {
              "ports": {
                "description": "Which emulator this session is on. Left out, the one on zxspectrum.server.*Port, started if nothing is there. \"auto\" starts a new one on free ports for this session alone, stopped when it ends -- so a second session is a second machine. An object names ports ({ \"dap\": 14711, \"screen\": 18500 }): whatever is listening there is joined, or a server is started on them; a port left out is the setting's. Ignored with debugServer.",
                "oneOf": [
                  { "type": "string", "enum": ["auto"] },
                  {
                    "type": "object",
                    "properties": {
                      "dap": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "mcp": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "screen": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "audio": { "type": "integer", "minimum": 1, "maximum": 65535 }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "sld": {
                "type": "string",
                "description": "Path to an sjasmplus SLD file, for source-level debugging of the program already running on the attached machine. Requires asm."
              },
              "asm": {
                "type": "string",
                "description": "Path to the source the sld file was assembled from. Requires sld."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "ZX Spectrum",
            "type": "zxspectrum",
            "request": "launch"
          }
        ],
        "configurationSnippets": [
          {
            "label": "ZX Spectrum: Launch",
            "description": "Start (or join) the emulator, reset it, and load a snapshot.",
            "body": {
              "name": "ZX Spectrum: ${1:My program}",
              "type": "zxspectrum",
              "request": "launch",
              "snapshot": "^\"\\${workspaceFolder}/${2:program.sna}\""
            }
          },
          {
            "label": "ZX Spectrum: Launch on a new emulator",
            "description": "Start an emulator of its own on free ports, beside any already running, and load a snapshot into it. Stopped when the session ends.",
            "body": {
              "name": "ZX Spectrum: ${1:My program} (own emulator)",
              "type": "zxspectrum",
              "request": "launch",
              "ports": "auto",
              "snapshot": "^\"\\${workspaceFolder}/${2:program.sna}\""
            }
          },
          {
            "label": "ZX Spectrum: Attach to a running emulator",
            "description": "Join the emulator as it is, without resetting it -- starting it first if nothing is running.",
            "body": {
              "name": "ZX Spectrum: Attach",
              "type": "zxspectrum",
              "request": "attach"
            }
          }
        ]
      }
    ]
  }
}
